# Required — Grok (xAI) generates the haikus and renders the memes
XAI_API_KEY=

# Required — Claude Opus is the last reasoning model: cleans up the thread
# and saves the important stuff (if any) before the burst dies
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# REDIS_URL=redis://127.0.0.1:6379/0
# XAI_BASE_URL=https://api.x.ai/v1
# GROK_CHAT_MODEL=grok-4-fast-non-reasoning
# GROK_IMAGE_MODEL=grok-2-image
# OPUS_MODEL=claude-opus-5
# EBC_MEME_DIR=memes
# EBC_SAVE_DIR=saved
