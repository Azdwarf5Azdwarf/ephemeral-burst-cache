#!/usr/bin/env ruby
# frozen_string_literal: true

require "redis"
require "json"

REDIS_URL = ENV.fetch("REDIS_URL", "redis://127.0.0.1:6379/0")

def redis
  @redis ||= Redis.new(url: REDIS_URL)
end

def check(name)
  print "#{name.ljust(32)} "
  begin
    result = yield
    if result
      puts "OK"
      true
    else
      puts "FAIL"
      false
    end
  rescue => e
    puts "FAIL (#{e.class}: #{e.message})"
    false
  end
end

puts "EBC Health Check"
puts "----------------"

results = []

results << check("Redis connectivity") do
  redis.ping == "PONG"
end

results << check("Persistence disabled (save)") do
  # CONFIG GET save should return empty or ""
  cfg = redis.config("get", "save")
  cfg[1].to_s.strip.empty? || cfg[1] == ""
end

results << check("AOF disabled") do
  cfg = redis.config("get", "appendonly")
  cfg[1].to_s.downcase == "no"
end

results << check("Namespace isolation") do
  test_key = "burst:healthcheck:test"
  redis.set(test_key, "1", ex: 10)
  exists = redis.exists?(test_key)
  redis.del(test_key)
  exists
end

results << check("TTL enforcement") do
  test_key = "burst:healthcheck:ttl"
  redis.set(test_key, "1", ex: 2)
  ttl = redis.ttl(test_key)
  redis.del(test_key)
  ttl > 0 && ttl <= 2
end

puts
if results.all?
  puts "All checks passed"
  exit 0
else
  puts "One or more checks failed"
  exit 1
end
