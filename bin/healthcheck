#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/ebc"

def redis
  @redis ||= Redis.new(url: EBC::Config::REDIS_URL)
end

# redis-rb returns CONFIG GET as ["key", "value"] in 4.x and {"key" => "value"} in 5+.
def config_value(key)
  cfg = redis.config("get", key)
  cfg.is_a?(Hash) ? cfg[key] : cfg[1]
end

def check(name)
  print "#{name.ljust(32)} "
  result = yield
  puts result ? "OK" : "FAIL"
  result
rescue StandardError => e
  puts "FAIL (#{e.class}: #{e.message})"
  false
end

puts "EBC Health Check"
puts "----------------"

results = []

results << check("Redis connectivity") do
  redis.ping == "PONG"
end

results << check("Persistence disabled (save)") do
  config_value("save").to_s.strip.empty?
end

results << check("AOF disabled") do
  config_value("appendonly").to_s.downcase == "no"
end

results << check("Namespace isolation") do
  test_key = "burst:healthcheck:test"
  redis.set(test_key, "1", ex: 10)
  exists = redis.exists?(test_key)
  redis.del(test_key)
  exists
end

results << check("TTL enforcement") do
  test_key = "burst:healthcheck:ttl"
  redis.set(test_key, "1", ex: 2)
  ttl = redis.ttl(test_key)
  redis.del(test_key)
  ttl.positive? && ttl <= 2
end

results << check("Anthropic API key (poets)") do
  !EBC::Config::ANTHROPIC_API_KEY.to_s.empty?
end

results << check("Grok API key (camera)") do
  !EBC::Config::XAI_API_KEY.to_s.empty?
end

results << check("GIF tool (ImageMagick)") do
  EBC::GroupPhoto::GIF_TOOLS.any? { |t| system("command -v #{t} > /dev/null 2>&1") }
end

puts
if results.all?
  puts "All checks passed"
  exit 0
else
  puts "One or more checks failed"
  exit 1
end
