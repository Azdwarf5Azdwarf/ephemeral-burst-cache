#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/ebc"

def usage
  abort <<~USAGE
    Usage:
      burst start [ttl]         Start a burst (default #{EBC::Config::DEFAULT_TTL}s)
      burst say <uuid> <text>   Post a message; the four haiku agents reply
      burst thread <uuid>       Print the thread so far
      burst status <uuid>       Show status and remaining TTL
      burst crystallise <uuid>  #{EBC::Config::MEME_COUNT} memes via Grok, then Opus curates the thread
      burst curate <uuid>       Opus only: clean up the thread, save what matters
      burst kill <uuid>         Destroy the namespace immediately
  USAGE
end

def live_burst(uuid)
  usage if uuid.nil?
  burst = EBC::Burst.new(uuid)
  abort "Burst #{uuid} is dead or never existed" unless burst.alive?
  burst
end

case ARGV[0]
when "start"
  ttl = (ARGV[1] || EBC::Config::DEFAULT_TTL).to_i
  burst = EBC::Burst.start(ttl: ttl)
  puts "Burst started"
  puts "  uuid: #{burst.uuid}"
  puts "  ttl:  #{ttl}s"
  puts "  ns:   burst:#{burst.uuid}:*"

when "say"
  uuid = ARGV[1]
  text = ARGV[2..].to_a.join(" ")
  usage if text.empty?
  burst = live_burst(uuid)
  burst.post("you", text)

  client = EBC::GrokClient.new
  EBC::HaikuAgent.lineup(client).each do |agent|
    haiku = agent.reply(burst.thread)
    burst.post(agent.name, haiku)
    puts "#{agent.name}:"
    puts haiku.gsub(/^/, "  ")
    puts
  end

when "thread"
  burst = live_burst(ARGV[1])
  burst.thread.each do |entry|
    puts "#{entry["author"]}:"
    puts entry["text"].gsub(/^/, "  ")
    puts
  end

when "status"
  burst = live_burst(ARGV[1])
  meta = burst.meta
  puts "Burst #{burst.uuid}"
  puts "  status:    #{meta["status"]}"
  puts "  started:   #{meta["started_at"]}"
  puts "  remaining: #{burst.ttl_remaining}s"
  puts "  messages:  #{burst.thread.size}"

when "crystallise", "crystallize"
  burst = live_burst(ARGV[1])
  memes = EBC::Crystallisation.new(burst).run
  puts "Crystallised #{memes.size} memes:"
  memes.each do |meme|
    puts "  #{meme[:path]}"
    puts "    #{meme[:prompt]}"
  end
  puts
  if EBC::Config::ANTHROPIC_API_KEY.to_s.empty?
    puts "ANTHROPIC_API_KEY not set — skipping Opus curation"
  else
    path = EBC::Curator.new.run(burst)
    puts path ? "Opus saved the important stuff: #{path}" : "Opus verdict: nothing worth saving"
  end

when "curate"
  burst = live_burst(ARGV[1])
  path = EBC::Curator.new.run(burst)
  puts path ? "Opus saved the important stuff: #{path}" : "Opus verdict: nothing worth saving"

when "kill"
  usage if ARGV[1].nil?
  count = EBC::Burst.new(ARGV[1]).kill
  puts count.zero? ? "Nothing to kill" : "Burst #{ARGV[1]} destroyed (#{count} keys)"

else
  usage
end
