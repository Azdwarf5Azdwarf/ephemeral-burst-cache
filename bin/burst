#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/ebc"

def usage
  abort <<~USAGE
    Usage:
      burst start [ttl]           Start a burst (default #{EBC::Config::DEFAULT_TTL}s)
      burst invite <uuid>         Print the code a friend needs to join
      burst join <uuid> <name>    Join someone else's burst
      burst say <uuid> <text>     Take your turn; the three poets answer
      burst thread <uuid>         Print the conversation so far
      burst status <uuid>         Who's here and how long is left
      burst photo <uuid> [pic]    The judge speaks, then the poets are drawn
                                  into the picture you took of you and your
                                  friends. Omit it and the whole thing is drawn.
      burst kill <uuid>           Destroy the namespace immediately

    Nothing survives a burst except the photo.
  USAGE
end

def live_burst(uuid)
  usage if uuid.nil?
  burst = EBC::Burst.new(uuid)
  abort "Burst #{uuid} is dead or never existed" unless burst.alive?
  burst
end

def poets_reply(burst)
  rhyme = nil
  EBC::SonnetAgent.lineup.each do |poet|
    stanza = poet.reply(burst.thread, rhyme_with: rhyme)
    next puts "#{poet.name} had nothing to say.\n\n" if stanza.nil?

    burst.post(poet.name, stanza)
    rhyme = EBC::SonnetAgent.rhyme_word(stanza)
    puts "#{poet.name}:"
    puts stanza.gsub(/^/, "  ")
    puts
  end
end

case ARGV[0]
when "start"
  ttl = (ARGV[1] || EBC::Config::DEFAULT_TTL).to_i
  burst = EBC::Burst.start(ttl: ttl)
  puts "Burst started"
  puts "  uuid: #{burst.uuid}"
  puts "  ttl:  #{ttl}s"
  puts
  puts "Invite someone:  ruby bin/burst join #{burst.uuid} <their name>"

when "invite"
  burst = live_burst(ARGV[1])
  puts "Tell your friend to run:"
  puts "  ruby bin/burst join #{burst.uuid} <their name>"
  puts
  puts "They have #{burst.ttl_remaining}s before it's gone."

when "join"
  burst = live_burst(ARGV[1])
  name = ARGV[2] or usage
  burst.add_participant(name)
  puts "#{name} joined. Here now: #{burst.participants.join(", ")}"

when "say"
  burst = live_burst(ARGV[1])
  text = ARGV[2..].to_a.join(" ")
  usage if text.empty?
  burst.post(burst.participants.first || "you", text)
  puts
  poets_reply(burst)

when "thread"
  burst = live_burst(ARGV[1])
  burst.thread.each do |entry|
    puts "#{entry["author"]}:"
    puts entry["text"].gsub(/^/, "  ")
    puts
  end

when "status"
  burst = live_burst(ARGV[1])
  meta = burst.meta
  puts "Burst #{burst.uuid}"
  puts "  started:   #{meta["started_at"]}"
  puts "  remaining: #{burst.ttl_remaining}s"
  puts "  here:      #{burst.participants.join(", ")}"
  puts "  stanzas:   #{burst.thread.size}"

when "photo"
  burst = live_burst(ARGV[1])
  verdict = EBC::Judge.new.run(burst)
  abort "Nothing happened here — no photo taken." if verdict.nil?

  # Said once, and never written down.
  puts
  puts verdict.words
  puts

  yours = ARGV[2]
  path = EBC::GroupPhoto.new(burst).run(verdict, photo: yours)
  puts yours ? "The poets joined you in: #{path}" : "The picture: #{path}"
  puts "Everything else dies with the burst."

when "kill"
  usage if ARGV[1].nil?
  count = EBC::Burst.new(ARGV[1]).kill
  puts count.zero? ? "Nothing to kill" : "Burst #{ARGV[1]} destroyed (#{count} keys)"

else
  usage
end
